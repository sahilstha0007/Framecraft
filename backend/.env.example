[TEMPLATE]
# FrameCraft API configuration
# Copy to .env and adjust as needed.

# Port the API listens on (frontend dev server runs on 3000)
PORT=3001

# Allowed CORS origin — the Next.js frontend
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
# Local dev instance (podman):
#   podman run -d --name framecraft-postgres \
#     -e POSTGRES_USER=framecraft -e POSTGRES_PASSWORD=framecraft \
#     -e POSTGRES_DB=framecraft -p 5432:5432 docker.io/library/postgres:16-alpine
DATABASE_URL=postgres://framecraft:framecraft@localhost:5432/framecraft

# Shared secret for admin write endpoints (POST / PUT / DELETE).
# The frontend admin page (/admin) sends it as the `x-admin-key` header.
# If unset, the API falls back to 'dev-admin-key' and warns at startup.
ADMIN_KEY=change-me-to-a-long-random-string
