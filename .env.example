# FrameCraft full-stack environment — copy to .env and adjust.
# Consumed by podman-compose.yaml (variable substitution).

# ── Frontend ───────────────────────────────────────────────────────────────
# Public API URL the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Canonical site URL for SEO (canonical links, OG images, sitemap).
NEXT_PUBLIC_SITE_URL=https://framecraft.com.np

# ── Backend ────────────────────────────────────────────────────────────────
# CORS origin the API accepts (the frontend URL in the browser).
FRONTEND_ORIGIN=http://localhost:3000
# Shared secret for admin write endpoints (x-admin-key header).
ADMIN_KEY=change-me-to-a-long-random-string
# Base URL used to build payment callback/verify URLs.
PUBLIC_BASE_URL=http://localhost:3001

# ── Nepali payment gateways (sandbox-first) ────────────────────────────────
KHALTI_SECRET_KEY=
KHALTI_API=https://dev.khalti.com/api/v2
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_API=https://rc-epay.esewa.com.np

# ── WhatsApp notifications (optional — in-app fallback when unset) ─────────
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TO=9779843082974
